# 复制为 .env 后填写；dev/smoke/stop:check 会读取根目录 .env。
CASEPILOT_HOST=127.0.0.1
CASEPILOT_PORT=4310
CASEPILOT_DATA_DIR=./data
CASEPILOT_BASE_URL=https://model-gateway.example.invalid/v1
CASEPILOT_MODEL_ID=replace-with-your-model-id
CASEPILOT_API_KEY=
# 可选：每条用例执行时限，默认 300000，允许 1000–900000。
# 较慢模型的多阶段用例可设为 600000，仍不自动重跑用例。
CASEPILOT_CASE_TIMEOUT_MS=300000
# 可选：每阶段的定位恢复次数和累计活动时间；暂停不计入恢复时间。
CASEPILOT_STEP_RECOVERY_ATTEMPTS=2
CASEPILOT_STEP_RECOVERY_TIMEOUT_MS=120000
# 普通图片验证码最多识别/提交次数；刷新最多为该值减一。
CASEPILOT_CAPTCHA_ATTEMPTS=3
# 默认关闭；本机可控样本验收配置可设为 1，真实环境仍需验收。
CASEPILOT_ENABLE_RUNNER=0
